{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etonify.app/schemas/desktop-runtime-v1.json",
  "title": "Etonify desktop runtime protocol v1",
  "description": "UTF-8 JSON framed by uint32 little-endian byte length, maximum 16777216 bytes. Malformed or truncated streams are terminal. Object keys encoded lexicographically for shared fixtures.",
  "$ref": "#/$defs/RuntimeEnvelope",
  "$defs": {
    "Generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807, "description": "Wire decoders require integer JSON tokens; decimal and exponent spellings are rejected, even when mathematically integral."},
    "RuntimeError": {
      "type": "object", "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}}
    },
    "RuntimeEnvelope": {
      "type": "object",
      "required": ["version", "kind", "id", "sessionId", "configGeneration", "networkGeneration", "method"],
      "properties": {
        "version": {"type": "integer", "const": 1},
        "kind": {"enum": ["request", "response", "event"]},
        "id": {"type": "string"}, "sessionId": {"type": "string"},
        "configGeneration": {"$ref": "#/$defs/Generation"},
        "networkGeneration": {"$ref": "#/$defs/Generation"},
        "method": {"type": "string"}, "payload": true,
        "error": {"$ref": "#/$defs/RuntimeError"}
      },
      "oneOf": [
        {"required": ["payload"], "not": {"required": ["error"]}},
        {"required": ["error"], "properties": {"kind": {"const": "response"}}, "not": {"required": ["payload"]}}
      ]
    },
    "Request": {"allOf": [{"$ref": "#/$defs/RuntimeEnvelope"}, {"properties": {"kind": {"const": "request"}}}]},
    "Event": {"allOf": [{"$ref": "#/$defs/RuntimeEnvelope"}, {"properties": {"kind": {"const": "event"}}}]},
    "Modes": {
      "type": "object",
      "properties": {
        "tunEnabled": {"type": "boolean", "default": false},
        "systemProxyEnabled": {"type": "boolean", "default": false},
        "launchAtLogin": {"type": "boolean", "default": false},
        "launchMinimized": {"type": "boolean", "default": true},
        "connectOnLaunch": {"type": "boolean", "default": false},
        "processRoutingMode": {"enum": ["allExceptSelected", "onlySelected"], "default": "allExceptSelected"},
        "processPaths": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "Presentation": {
      "type": "object", "properties": {"proxyListStyle": {"enum": ["compact", "comfortable"], "default": "compact"}}
    },
    "Capabilities": {
      "type": "object", "description": "Unknown names are never implicitly supported.",
      "properties": {
        "localProxy": {"type": "boolean", "default": false},
        "tun": {"type": "boolean", "default": false},
        "processRouting": {"type": "boolean", "default": false},
        "systemProxy": {"type": "boolean", "default": false}
      }
    },
    "Snapshot": {
      "type": "object",
      "required": ["sessionId", "configGeneration", "networkGeneration", "phase", "modes", "selectedTag", "coreVersion", "daemonApiVersion", "serviceVersion", "capabilities"],
      "properties": {
        "sessionId": {"type": "string"},
        "configGeneration": {"$ref": "#/$defs/Generation"},
        "networkGeneration": {"$ref": "#/$defs/Generation"},
        "phase": {"enum": ["stopped", "starting", "connected", "applying", "stopping", "failed"]},
        "modes": {"$ref": "#/$defs/Modes"}, "selectedTag": {"type": "string"},
        "coreVersion": {"type": "string"}, "daemonApiVersion": {"$ref": "#/$defs/Generation"},
        "serviceVersion": {"type": "string"}, "capabilities": {"$ref": "#/$defs/Capabilities"},
        "error": {"$ref": "#/$defs/RuntimeError"}
      }
    },
    "StartRequest": {
      "type": "object", "required": ["config", "modes", "sessionId", "configGeneration", "networkGeneration"],
      "properties": {
        "config": {"type": "string"}, "modes": {"$ref": "#/$defs/Modes"},
        "sessionId": {"type": "string"}, "configGeneration": {"$ref": "#/$defs/Generation"},
        "networkGeneration": {"$ref": "#/$defs/Generation"}
      }
    },
    "LaunchContext": {
      "type": "object", "required": ["installationId", "distribution", "dataRoot", "startedAtLogin", "minimized", "ownerPid"],
      "properties": {
        "installationId": {"type": "string"}, "distribution": {"enum": ["installed", "portable"]},
        "dataRoot": {"type": "string", "description": "Final absolute user root from native launcher, not CWD. Portable data/user or installed LOCALAPPDATA/Etonify/user. Dart must not append data/user again."},
        "startedAtLogin": {"type": "boolean"}, "minimized": {"type": "boolean"},
        "ownerPid": {"$ref": "#/$defs/Generation"}
      }
    }
  }
}
